{
  "info": {
    "name": "Product API — v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete collection for the Laravel Product API assessment."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token",    "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/me",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/logout",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "search",    "value": "",      "disabled": true },
                { "key": "min_price", "value": "10",    "disabled": true },
                { "key": "max_price", "value": "500",   "disabled": true },
                { "key": "in_stock",  "value": "true",  "disabled": true },
                { "key": "sort_by",   "value": "price", "disabled": true },
                { "key": "sort_dir",  "value": "asc",   "disabled": true },
                { "key": "per_page",  "value": "15",    "disabled": true }
              ]
            },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "List — search + filter example",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?search=headphone&min_price=50&in_stock=true&sort_by=price&sort_dir=asc",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "search",    "value": "headphone" },
                { "key": "min_price", "value": "50" },
                { "key": "in_stock",  "value": "true" },
                { "key": "sort_by",   "value": "price" },
                { "key": "sort_dir",  "value": "asc" }
              ]
            },
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/REPLACE-WITH-UUID",
            "header": [{ "key": "Accept", "value": "application/json" }]
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Wireless Headphones\",\n  \"description\": \"High-fidelity over-ear headphones with active noise cancellation.\",\n  \"price\": 99.99,\n  \"stock\": 50\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/products/REPLACE-WITH-UUID",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 79.99,\n  \"stock\": 25\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/products/REPLACE-WITH-UUID",
            "header": [
              { "key": "Accept",        "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    }
  ]
}
