        {
            "name": "Products",
            "description": "\nEndpoints for managing the product catalogue.",
            "item": [
                {
                    "name": "List products",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/products",
                            "query": [
                                {
                                    "key": "search",
                                    "value": "headphones",
                                    "description": "Filter by name or description.",
                                    "disabled": false
                                },
                                {
                                    "key": "min_price",
                                    "value": "10",
                                    "description": "Filter products with price \u2265 this value.",
                                    "disabled": false
                                },
                                {
                                    "key": "max_price",
                                    "value": "500",
                                    "description": "Filter products with price \u2264 this value.",
                                    "disabled": false
                                },
                                {
                                    "key": "in_stock",
                                    "value": "1",
                                    "description": "Return only in-stock (true) or out-of-stock (false) products.",
                                    "disabled": false
                                },
                                {
                                    "key": "sort_by",
                                    "value": "price",
                                    "description": "Column to sort by. Allowed: price, created_at, name. Defaults to created_at.",
                                    "disabled": false
                                },
                                {
                                    "key": "sort_dir",
                                    "value": "asc",
                                    "description": "Sort direction: asc or desc. Defaults to desc.",
                                    "disabled": false
                                },
                                {
                                    "key": "per_page",
                                    "value": "20",
                                    "description": "Number of results per page (1\u2013100). Defaults to 15.",
                                    "disabled": false
                                }
                            ],
                            "raw": "{{baseUrl}}\/api\/v1\/products?search=headphones&min_price=10&max_price=500&in_stock=1&sort_by=price&sort_dir=asc&per_page=20"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns a paginated list of products. Supports full-text search,\nprice-range and stock filters, and column sorting.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"data\": [{\"id\": \"uuid\", \"name\": \"...\", \"price\": 99.99, \"stock\": 10, \"in_stock\": true, \"created_at\": \"...\"}],\n  \"links\": {\"first\": \"...\", \"last\": \"...\", \"prev\": null, \"next\": \"...\"},\n  \"meta\": {\"current_page\": 1, \"per_page\": 15, \"total\": 100}\n}",
                            "name": ""
                        }
                    ]
