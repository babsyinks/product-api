        {
            "name": "Authentication",
            "description": "\nEndpoints for obtaining and revoking API tokens (Laravel Sanctum).",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/register",
                            "query": [],
